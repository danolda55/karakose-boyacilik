# Karaköse Boyacılık — sunucu ayarları (GitHub'dan otomatik yüklenir)
DirectoryIndex index.html
Options -Indexes -MultiViews
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# Tek adres: https ve www'suz (Google aynı sayfayı iki kez saymasın)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://xn--karakseboyaclk-zpb56gba.com.tr%{REQUEST_URI} [R=301,L]

# /index.html -> /
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^ / [R=301,L]

# /sayfa.html -> /sayfa/
RewriteCond %{THE_REQUEST} \s/+([^.\s?/]+)\.html[\s?] [NC]
RewriteCond %1 !^404$
RewriteRule ^ /%1/ [R=301,L]

# /sayfa -> /sayfa/
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([^/.]+)$ /$1/ [R=301,L]

# /sayfa/ -> sayfa.html (içeriden)
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([^/.]+)/$ $1.html [L]
</IfModule>

# Yükleme durum dosyasını gizle
<Files ".ftp-deploy-sync-state.json">
    Require all denied
</Files>

# Sıkıştırma
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml application/xml application/manifest+json
</IfModule>

# Önbellek: CSS/JS sürüm numaralı, görseller uzun süre
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/html "access plus 0 seconds"
ExpiresByType text/css "access plus 1 year"
ExpiresByType application/javascript "access plus 1 year"
ExpiresByType image/webp "access plus 6 months"
ExpiresByType image/jpeg "access plus 6 months"
ExpiresByType image/png "access plus 6 months"
ExpiresByType image/svg+xml "access plus 6 months"
ExpiresByType image/x-icon "access plus 6 months"
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

AddType application/manifest+json .webmanifest
AddType image/webp .webp
